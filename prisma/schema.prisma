// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  uuid          String         @unique @default(uuid())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model Page {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(uuid())
  nameEN    String
  nameAR    String
  isVisible Boolean   @default(false)
  index     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  sections  Section[]
}

model Section {
  id                Int                @id @default(autoincrement())
  uuid              String             @unique @default(uuid())
  nameEN            String
  nameAR            String
  index             Int                @default(0)
  pageId            Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime?          @updatedAt
  sectionComponents SectionComponent[]
  page              Page               @relation(fields: [pageId], references: [id])
}

model Component {
  id                Int                @id @default(autoincrement())
  uuid              String             @unique @default(uuid())
  nameEN            String
  nameAR            String
  index             Int                @default(0)
  parentId          Int?
  parent            Component?         @relation("ComponentTree", fields: [parentId], references: [id])
  children          Component[]        @relation("ComponentTree")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime?          @updatedAt
  sectionComponents SectionComponent[]
}

model SectionComponent {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(uuid())
  sectionId         Int
  componentId       Int
  index             Int       @default(0)
  section           Section   @relation(fields: [sectionId], references: [id])
  component         Component @relation(fields: [componentId], references: [id])
  componentData     Json      @db.JsonB
  componentSettings Json      @db.JsonB
  updatedAt         DateTime  @updatedAt
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
}
